{
  "name": "Vaulty",
  "short_name": "Vaulty",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#17191D",
  "theme_color": "#17191D",
  "icons": [
    { "src": "/1.ico", "sizes": "256x256", "type": "image/x-icon" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "images", "accept": ["image/*"] }
      ]
    }
  }
}
